{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local.invalid/opencode/review-result.v1.schema.json",
  "title": "review-result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "plan_revision",
    "design_id",
    "design_revision",
    "requirements_id",
    "requirements_revision",
    "review_attempt_id",
    "execution_attempt_id",
    "completed_at",
    "base_commit",
    "resulting_commit",
    "source_snapshot",
    "source_unchanged",
    "mechanical_checks",
    "criteria",
    "semantic",
    "disposition",
    "summary",
    "profile_id"
  ],
  "properties": {
    "schema_version": {
      "const": "review-result/v1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "design_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "design_revision": {
      "type": "integer",
      "minimum": 1
    },
    "requirements_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "requirements_revision": {
      "type": "integer",
      "minimum": 1
    },
    "review_attempt_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "execution_attempt_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "completed_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "base_commit": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{40}$"
    },
    "resulting_commit": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_snapshot": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_unchanged": {
      "type": "boolean"
    },
    "mechanical_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "required",
          "status",
          "argv",
          "exit_code",
          "evidence",
          "log_artifact",
          "working_directory",
          "tool_versions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "build",
              "format",
              "lint",
              "typecheck",
              "test"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not_run",
              "environment_error"
            ]
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "log_artifact": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "working_directory": {
            "type": "string",
            "minLength": 1
          },
          "tool_versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            },
            "then": {
              "properties": {
                "exit_code": {
                  "const": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "properties": {
                "exit_code": {
                  "type": "integer",
                  "not": {
                    "const": 0
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not_run"
                }
              }
            },
            "then": {
              "properties": {
                "exit_code": {
                  "const": null
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_schema",
        "review_id",
        "status",
        "reason",
        "model",
        "raw_result",
        "findings"
      ],
      "properties": {
        "source_schema": {
          "type": "string",
          "enum": [
            "review.result/v1",
            "opencode.review.error/v1"
          ]
        },
        "review_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "APPROVED",
            "CHANGES_REQUESTED",
            "INDETERMINATE",
            "ERROR"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "raw_result": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "blocking",
              "message",
              "severity"
            ],
            "properties": {
              "blocking": {
                "type": "boolean"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "path": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "line": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recommendation": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "APPROVED"
              }
            }
          },
          "then": {
            "properties": {
              "findings": {
                "items": {
                  "properties": {
                    "blocking": {
                      "const": false
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "CHANGES_REQUESTED"
              }
            }
          },
          "then": {
            "properties": {
              "findings": {
                "contains": {
                  "properties": {
                    "blocking": {
                      "const": true
                    }
                  },
                  "required": [
                    "blocking"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ERROR"
              }
            }
          },
          "then": {
            "properties": {
              "source_schema": {
                "const": "opencode.review.error/v1"
              }
            }
          },
          "else": {
            "properties": {
              "source_schema": {
                "const": "review.result/v1"
              },
              "review_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "accepted",
        "changes_requested",
        "indeterminate"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "source_unchanged": {
            "const": true
          },
          "semantic": {
            "properties": {
              "status": {
                "const": "APPROVED"
              }
            }
          },
          "mechanical_checks": {
            "items": {
              "if": {
                "properties": {
                  "required": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              }
            }
          },
          "criteria": {
            "items": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "changes_requested"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "semantic": {
                "properties": {
                  "status": {
                    "const": "CHANGES_REQUESTED"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "mechanical_checks": {
                "contains": {
                  "properties": {
                    "required": {
                      "const": true
                    },
                    "status": {
                      "const": "failed"
                    }
                  },
                  "required": [
                    "required",
                    "status"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "criteria": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "failed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "source_unchanged": {
                "const": false
              }
            }
          },
          {
            "properties": {
              "semantic": {
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "INDETERMINATE",
                      "ERROR"
                    ]
                  }
                }
              }
            }
          },
          {
            "properties": {
              "mechanical_checks": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "environment_error"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "disposition": {
            "const": "indeterminate"
          }
        }
      }
    }
  ]
}
