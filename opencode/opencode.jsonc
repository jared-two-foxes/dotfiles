{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/claude-haiku-4-5",
  "agent": {
    "title":      { "model": "opencode/claude-haiku-4-5" },
    "summary":    { "model": "opencode/deepseek-v4-flash" },
    "compaction": { "model": "opencode/gemini-3.1-pro" },
    "explore":    { "model": "opencode/gemini-3.1-pro" },
    "general":    { "model": "opencode/gemini-3.1-pro" }
    // "build":      { "disable": true },
    // "plan":       { "disable": true }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ],
  "provider": {
    "local-ollama": {
      "name": "Local Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3-coder": {
          "name": "Qwen3 Coder"
        },
        "qwen3.6:27b": {
          "name": "Qwen3.6"
        }
      }
    }
  },
  "mcp": {
    "linear": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@tacticlaunch/mcp-linear"],
      "environment": {
        "LINEAR_API_KEY": "{file:~/.secrets/linear-key}"
      }
    },
    "recallium": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "recallium"],
      "environment": {
        "RECALLIUM_SERVER_URL": "http://localhost:8001/mcp"
      }
    },
    "stripe": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@stripe/mcp@latest"],
      "environment": {
        "STRIPE_SECRET_KEY": "{file:~/.secrets/stripe-key}"
      }
    }
  }
}
